{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Machinists BenchMate",
  "version": "0.1.0",
  "identifier": "com.jkdesignpro.benchmate",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "jkdesignpro",
    "copyright": "Machinists BenchMate contributors. AGPL-3.0-or-later.",
    "license": "AGPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Offline machinist's calculator",
    "longDescription": "A free, open-source (AGPLv3) machinist's calculator for mills, lathes and Swiss-type machines. Works fully offline.",
    "homepage": "https://github.com/jkdesignpro/Machinists-BenchMate",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  }
}
