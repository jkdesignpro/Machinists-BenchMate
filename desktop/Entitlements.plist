<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: allow audio input (microphone) for the chatter
	     finder. The Tauri bundler signs with the hardened runtime on by
	     default, also with the ad hoc identity "-", and the release workflow
	     re-signs with the same options. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
