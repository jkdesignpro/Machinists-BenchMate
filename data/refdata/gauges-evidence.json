{
 "_about": "Sheet metal and wire gauges as two publishers print them, in inches. A value counts as confirmed when both print the same at the coarser printed precision. The American wire gauge is not in this file: it follows a rule and is computed in core/src/gauges.rs.",
 "sources": {
  "WIKI_SHEET": {
   "publisher": "Wikipedia",
   "title": "Sheet metal: standard sheet metal gauges",
   "url": "https://en.wikipedia.org/wiki/Sheet_metal",
   "accessed": "2026-11-12",
   "note": "Columns: US standard for sheet and plate iron and steel (cited to Machinery's Handbook and 15 U.S.C. 206), Manufacturers' Standard Gauge for sheet steel, galvanized steel, stainless steel, steel tube wall thickness, aluminium, zinc. Zinc is not entered. Rows 9, 13, 14, 15, 17, 21, 24, 26 and 27 were read a second time cell by cell."
  },
  "ETB_GAUGE": {
   "publisher": "The Engineering ToolBox",
   "title": "Gauge and weight chart: sheet steel, galvanized steel, stainless steel, aluminum, strip and tubing",
   "url": "https://engineeringtoolbox.com/amp/gauge-sheet-d_915.html",
   "accessed": "2026-11-12",
   "note": "US Standard Gauge 44 to 7/0; sheet steel 38 to 3; galvanized 30 to 8 (three places); stainless 38 to 6/0; aluminum 38 to 6/0; strip and tubing 36 to 5/0. Weights per square foot are not entered. A sheet metal supplier's page (riversidesheetmetal.net) prints the same chart and is not counted as a separate publisher."
  },
  "WIKI_SWG": {
   "publisher": "Wikipedia",
   "title": "Standard wire gauge",
   "url": "https://en.wikipedia.org/wiki/Standard_wire_gauge",
   "accessed": "2026-11-12",
   "note": "SWG 7/0 to 50; defined by BS 3737:1964, since withdrawn; fixed by Order in Council in 1883."
  },
  "ETB_SWG": {
   "publisher": "The Engineering ToolBox",
   "title": "SWG: Standard Wire Gauge",
   "url": "https://www.engineeringtoolbox.com/amp/swg-standard-wire-gauge-d_1779.html",
   "accessed": "2026-11-12",
   "note": "SWG 7/0 to 50 in inches and mm; BS 3737:1964, withdrawn. Its mm figure for 1/0 (8.236) does not match its own 0.324 in (8.230 mm); the inch values are entered."
  }
 },
