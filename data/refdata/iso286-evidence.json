{
 "sources": {
  "WIKI_IT": {
   "publisher": "Wikipedia",
   "title": "IT Grade (article, table of IT values)",
   "url": "https://en.wikipedia.org/wiki/IT_Grade",
   "accessed": "2026-11-10",
   "note": "IT01 to IT11 printed in um, IT12 to IT18 in mm (converted to um here, x1000). Sizes over 500 to 3150 mm (IT1 to IT18; IT01 and IT0 not defined there) added 2026-11-11; the flattened table has 18 values per row, placed in IT1 to IT18 by count (IT01/IT0 blank)."
  },
  "GANTER_IT": {
   "publisher": "Otto Ganter GmbH",
   "title": "DIN ISO 286 ISO-Grundtoleranzen, Auszug Teil 1 Zahlenwerte (technical appendix p. 2150)",
   "url": "https://ganternorm.com/fileadmin/user_upload/downloads/technischer%20anhang/286_1.pdf",
   "accessed": "2026-11-10",
   "note": "Printed in um with decimal commas. IT18 over 315 to 400 printed as 2200, out of sequence with its neighbours (8100, 9700); recorded as printed."
  },
  "GOST_25346": {
   "publisher": "GOST (Gosstandart), transcription at dnaop.com",
   "title": "GOST 25346-89 Unified system of tolerances and fits, Tables 2 and 3 (national adoption of ISO 286-1:1988)",
   "url": "https://dnaop.com/html/65935_2.html",
   "accessed": "2026-11-10",
   "note": "Table 2 (shafts) and Table 3 (holes, page 65935_3/_4, including the delta values). Merged cells cover the main size step; recorded on the main step. f over 30 to 40 printed '25' without its sign in the transcription (column is negative); recorded as -25. Over 500 to 3150 mm (added 2026-11-11): shafts d, e, f, g, m, n, p on the main steps, r, s, t, u on the intermediate steps; d over 630 to 710 printed \"290\" without its sign (column is negative), recorded as -290; u over 500 to 560 printed \"*+*600\", recorded as 600. Holes J6, J7, J8 (Table 3, page 65935_3) up to 500 mm; above 500 mm J is printed as a dash (not defined)."
  },
  "ROYMECH": {
   "publisher": "RoyMech (Roy Beardmore)",
   "title": "ISO shaft fundamental deviations 0 to 500 mm",
   "url": "https://www.roymech.co.uk/Useful_Tables/ISO_Tolerances/ISO_SHAFT_LIM_1.html",
   "accessed": "2026-11-10",
   "note": "The site does not permit substantial reproduction, so its table is not republished here. It was compared value by value with the GOST 25346 transcription for letters a to zc (except j, js, k): all 517 printed values are equal. Only its k column is recorded. j (added 2026-11-11): its j5/j6 and j7 columns were compared with Simply Bearings, not republished. j7 agrees on every step 3 to 400 mm; for j5/j6 the transcription read -3, -4, -5 over 18 to 30, 30 to 50 and 50 to 65 mm where Simply Bearings prints -4, -5, -7 (likely a row shift in the text extraction; shown as a disagreement). Its 0 to 3 and 400 to 500 mm values (j5/j6 -2 and -20, j7 -4 and -32) are recorded as single-source values."
  },
  "SIMPLYB": {
   "publisher": "Simply Bearings Ltd",
   "title": "FAQ / ISO 286 Limits and Fits reference (shaft and hole limit deviations, ISO 286-2)",
   "url": "https://simplybearings.co.uk/shop/Info-Pages-ISO-Limits/c4746_4779/index.html",
   "accessed": "2026-11-10",
   "note": "Prints limit deviations of tolerance classes for 3 to 400 mm. The fundamental deviation is read as the limit nearest zero of the class named in 'from'. f6 over 120 to 180 printed -43/-48 (lower limit inconsistent with f5/f7; the upper, fundamental, value -43 is unaffected). j5, j6, j7 and J6, J7, J8 limit deviations (added 2026-11-11): the page leaves the rows it does not print blank and the text extraction labelled the printed rows wrongly; BenchMate placed them on the main steps 3-6 ... 315-400 using upper - lower = IT of the grade, which every row satisfies."
  },
  "OSG_JIS": {
   "publisher": "OSG Corporation",
   "title": "Deviation of shafts to be used in commonly used fits (JIS B 0401 extract)",
   "url": "https://www.osg.co.jp/media_dl/technical/file/hameai.pdf",
   "accessed": "2026-11-10",
   "note": "JIS B 0401 is the Japanese adoption of ISO 286. Prints limit deviations up to 250 mm; fundamental deviation read as the limit nearest zero."
  }
 },
