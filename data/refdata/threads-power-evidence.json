{
 "sources": {
  "TORQ_ACME": {
   "publisher": "Torqbolt",
   "title": "Unified ACME threads dimensions specifications (general purpose, basic dimensions table)",
   "url": "https://torqbolt.com/unified-acme-threads-dimensions-specifications",
   "accessed": "2026-11-11",
   "note": "Fastener maker. Cites ASME/ANSI B1.5-1997. Prints size, TPI, basic pitch and minor diameters, flat 0.3707P and lead angle for 1/4 to 5 in, and the major/minor tolerance and clearance rules in prose."
  },
  "TORQ_STUB": {
   "publisher": "Torqbolt",
   "title": "Stub ACME dimensions specifications",
   "url": "https://torqbolt.com/stub-acme-dimensions-specifications",
   "accessed": "2026-11-11",
   "note": "Cites ASME/ANSI B1.8-1988 (R2001). Prints h = 0.3P, flat 0.4224P, the major/minor rules and a size table 1/4 to 5 in."
  },
  "MD_ACME": {
   "publisher": "MachiningDoctor",
   "title": "ACME threads: dimensions, charts and formulas; 2-4 ACME thread data page (threadinfo-acme, tid 5014)",
   "url": "https://machiningdoctor.com/charts/acme",
   "accessed": "2026-11-11",
   "note": "States the pitch diameter tolerance as K1 sqrt P + K2 sqrt D with 0.030/0.006 (2G), 0.014/0.0028 (3G), 0.010/0.002 (4G); its class labels and two constants carry typos (0.002 for 0.020, TPI/20 for P/20). Its 2-4 page prints limits for 2G, 3G, 4G, 2C, 3C and 4C (https://www.machiningdoctor.com/threadinfo-acme?tid=5014), used in the tests."
  },
  "NBS_H28": {
   "publisher": "National Bureau of Standards (US government)",
   "title": "Handbook H28 (1957), Screw-thread standards for federal services, Part III (Acme and Stub Acme sections)",
   "url": "https://nvlpubs.nist.gov/nistpubs/Legacy/hb/nbshandbook28supp1957pt3.pdf",
   "accessed": "2026-11-11",
   "note": "Public domain. Used for the formulas only: pitch diameter allowances 0.008, 0.006, 0.004 sqrt D; tolerance 0.030 sqrt(1/n) + 0.006 sqrt D (2), 0.014 + 0.0028 (3), 0.010 + 0.002 (4); clearance 0.020 / 0.010 in; screw minor tolerance 1.5 x PD tolerance; centralizing nut minor 0.1 P above basic; Stub ACME h = 0.3P, flat 0.4224P. The scan is OCR and some tables are unreadable."
  },
  "RM_TR": {
   "publisher": "RoyMech",
   "title": "Metric trapezoidal screw threads (ISO 2904 table and profile formulas)",
   "url": "https://roymech.org/Useful_Tables/Screws/Trapezoidal.html",
   "accessed": "2026-11-11",
   "note": "Engineering reference site. Prints the ISO 2904 profile formulas and d, P, d2, D4, d3, D1. Cites the 1977 editions of ISO 2901 to 2904. The Tr 32 x 6 row was read as D4 32.500, which does not fit its own d3 25.000 (formula 33.000); not used."
  },
  "ETB_TR": {
   "publisher": "The Engineering ToolBox",
   "title": "Trapezoidal metric screw threads (ISO 2901)",
   "url": "https://www.engineeringtoolbox.com/trapezoidal-metric-screw-threads-d_2042.html",
   "accessed": "2026-11-11",
   "note": "Prints screw diameter x pitch, nut inside diameter D1, nut crest (0.366P) and the clearances ac for Tr 8 x 1.5 to Tr 24 x 5."
  },
  "RECOIL": {
   "publisher": "Alcoa Fastening Systems (Recoil)",
   "title": "Recoil threaded inserts, taps, tooling and kits catalog, tapped hole data p. 25",
   "url": "https://www.newmantools.com/sti/Recoil2007ntCatalog.pdf",
   "accessed": "2026-11-11",
   "note": "Insert maker. UNC tapped-hole (STI) minor diameter, major diameter minimum and pitch diameter limits for classes 2B and 3B. Copy hosted by a distributor; no year printed on the pages read."
  },
  "KATO": {
   "publisher": "Kato Fastening Systems",
   "title": "KATO Tangless and Tanged CoilThread inserts and tools catalog (2003), drilled hole dimensions pp. 10 and 12",
   "url": "https://www.hardwarespecialty.com/products/pdf/vendor_kato_tang_tangless_catalog.pdf",
   "accessed": "2026-11-11",
   "note": "Insert maker. Tapped hole minor diameters, inch (NASM33537) and metric (MA1567). Copy hosted by a distributor. Only the first two of the three minor diameter columns are used (minimum, maximum for the tighter class)."
  },
  "VARGUS_HC": {
   "publisher": "Vargus",
   "title": "Heli-Coil drilling data, inch, and Heli-Coil thread data, metric (help file of the Vargus thread milling software)",
   "url": "https://vargen.vargus.com/VargusGenWeb/help/helicoil.pdf",
   "accessed": "2026-11-11",
   "note": "Thread tool maker reprinting Heli-Coil STI data. 1/4-20 and M10 x 1.5 rows read; the 1/4-20 major diameter column (.3187) is not labelled clearly enough to use."
  },
  "TC_PLATE": {
   "publisher": "Thread Check Inc.",
   "title": "Calculating pre-plate screw threads gages",
   "url": "https://www.threadcheck.com/calculating-pre-plate-screw-threads-gages/technicalinfo/",
   "accessed": "2026-11-11",
   "note": "Gauge maker. States the 4:1 pitch diameter build-up for 60 degree threads and the half-and-half rule for major and minor diameters, with a 1/2-20 UNF 2A/2B worked example (used in the tests)."
  },
  "KATO_PLATE": {
   "publisher": "Kato Fastening Systems",
   "title": "The effects of plating",
   "url": "https://katofastening.com/article/effectsplating.html",
   "accessed": "2026-11-11",
   "note": "Insert maker. States that a 60 degree thread's pitch diameter changes by four times the coating thickness, and that a plated helical insert counts twice (8 x thickness) because it carries both threads."
  },
  "AMES_UN": {
   "publisher": "AMESweb",
   "title": "Thread pitch chart (UNC / UNF / UNEF / UN), constant-pitch columns 4-UN to 32-UN",
   "url": "https://amesweb.info/Screws/Tables/Thread-Pitch-Chart-UNC-UNF-UNEF-UN.aspx",
   "accessed": "2026-11-11",
   "note": "Engineering calculator site; cites ASME B1.1. Sizes up to 2 in. Prints the pitch in the constant-pitch column even where it equals the UNC or UNF pitch."
  },
  "TORQ_UN": {
   "publisher": "Torqbolt",
   "title": "Diameter-pitch combinations for UN and UNR thread series",
   "url": "https://mail.torqbolt.com/pitch-diameter-combinations-un-unr-thread-series",
   "accessed": "2026-11-11",
   "note": "Table runs to 4 in; only the 1 to 2 in rows were read. Prints UNC or UNF in the constant-pitch column where the pitch belongs to the graded series."
  },
  "AMES_BUTT": {
   "publisher": "AMESweb",
   "title": "Buttress thread chart and calculator (7/45 form)",
   "url": "https://amesweb.info/Screws/buttress-thread-chart-calculator.aspx",
   "accessed": "2026-11-11",
   "note": "Cites ANSI B1.9-1973. Prints the basic constants H 0.89064P, h 0.6P, r 0.07141P, s 0.0826P, S 0.0928P, f 0.14532P, F 0.16316P, hs = hn 0.66271P and the diameter formulas; no allowance or tolerance values."
  },
  "TORQ_UNJ": {
   "publisher": "Torqbolt",
   "title": "UNJC unified coarse threads for aerospace fasteners (controlled root radius and increased minor diameter)",
   "url": "https://torqbolt.com/unjc-unified-coarse-threads-aerospace-fasteners",
   "accessed": "2026-11-11",
   "note": "Cites ASME B1.15 (1995) and MIL-S-8879C. Root radius 0.15011P to 0.18042P; UNJC 3A/3B limits printed in mm to 0.01 (used in the tests)."
  },
  "RPG_UNJ": {
   "publisher": "Gage Crib Worldwide (Ring and Plug Thread Gages)",
   "title": "UNJ vs UN",
   "url": "https://ring-plug-thread-gages.com/ti-UNJ-vs-UN.htm",
   "accessed": "2026-11-11",
   "note": "Gauge maker. Root radius minimum 0.15011p, maximum 0.18042p; names SAE AS8879 (formerly MIL-S-8879) and ASME B1.15."
  },
  "TC_UNR": {
   "publisher": "Thread Check Inc.",
   "title": "UNR screw thread form",
   "url": "https://www.threadcheck.com/unr-screw-thread-form/technicalinfo/",
   "accessed": "2026-11-11",
   "note": "Gauge maker. Quotes ASME B1.1 para. 2.3.1: root radius of curvature not less than 0.10825318P, tangency point not less than 0.625H below the basic major diameter; external threads only; UN ring gauges check UNR."
  },
  "TC_WIRE": {
   "publisher": "Thread Check Inc.",
   "title": "Approximate formulas for measured pitch diameter",
   "url": "https://www.threadcheck.com/approximate-formulas-for-measured-pitch-diameter/technicalinfo/",
   "accessed": "2026-11-11",
   "note": "Gauge maker. Best wire 0.57735P (60), 0.56369P (55), 0.51645P (29); E = M - (3G - .86603P) (60), M - (3.16568G - .96049P) (55), M - (4.9939G - 1.933357P) (29, ACME); for lead angles up to 5 degrees."
  },
  "TC_UNM": {
   "publisher": "Thread Check Inc.",
   "title": "Unified miniature screw threads per ASME B1.10M-2004",
   "url": "https://www.threadcheck.com/unified-miniature-screw-threads-per-asme-b1-10m-2004/technicalinfo/",
   "accessed": "2026-11-11",
   "note": "Gauge maker. Basic and design dimensions 0.30 to 1.40 UNM and the profile constants (basic height 0.48P, external design height 0.5725907P, root radii 0.1851815P external, 0.0721688P internal). The two minor diameter columns were read with their headers swapped; they are assigned here by the profile formulas."
  },
  "AMES_UNM": {
   "publisher": "AMESweb",
   "title": "Unified miniature screw threads dimensions (external and internal limits of size)",
   "url": "https://amesweb.info/Screws/unified-miniature-screw-threads.aspx",
   "accessed": "2026-11-11",
   "note": "Cites ASME B1.10M-1997. Limits of size 0.30 to 1.40 UNM in mm. Two values do not fit the rest of its own rows: 1.00 UNM external pitch diameter max 0.839 (basic 0.838), 0.50 UNM internal minor min 0.390 (its max 0.432 less its tolerance 0.052 is 0.380)."
  }
