   "accessed": "2026-11-10",
   "note": "Toolholder maker. Values to 2 decimals without units (inch). Threads printed with pitch (\"M16 - 2.0\", \"5/8\" - 11\"); recorded as M16 and 5/8-11 for comparison."
  },
  "NEWMAN": {
   "publisher": "Newman Tools",
   "title": "Tapers: self-holding (Jarno rule, Brown & Sharpe table)",
   "url": "https://newmantools.com/tech/taper.htm",
   "accessed": "2026-11-12",
   "note": "Jarno: large diameter = size / 8, small = size / 10, length = size x 0.5, 0.600 in per foot; example No. 8. Brown & Sharpe: sizes 1 to 15, large and small diameters to five places, lengths as fractions; \"standardized at 0.500 in/ft\"."
  },
  "EE_JARNO": {
