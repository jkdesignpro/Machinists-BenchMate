  "TC_FACT": {
   "publisher": "Thread Check Inc.",
   "title": "Fixed limit gage fact sheet",
   "url": "https://www.threadcheck.com/fixed-limit-gage-fact-sheet/technicalinfo/",
   "accessed": "2026-11-12",
   "note": "Thread plug gauge: GO member plus tolerance, NOGO member minus. Thread ring gauge: GO member minus, NOGO member plus. GO checks the maximum material condition, NOGO the minimum."
  },
