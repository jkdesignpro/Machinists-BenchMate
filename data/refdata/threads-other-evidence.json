{
 "sources": {
  "WIKI_BSP": {
   "publisher": "Wikipedia",
   "title": "British Standard Pipe (size table)",
   "url": "https://en.wikipedia.org/wiki/British_Standard_Pipe",
   "accessed": "2026-11-10",
   "note": "Names ISO 7-1:1994 and ISO 228-1:2000. Prints TPI, pitch, major and minor diameter (in and mm), gauge length and tapping drills."
  },
  "ETB_BSP": {
   "publisher": "The Engineering ToolBox",
   "title": "ISO 228 - Pipe threads where pressure tight joints are not made on the threads",
   "url": "https://engineeringtoolbox.com/iso-228-pipe-threads-d_2037.html",
   "accessed": "2026-11-10",
   "note": "Major diameter printed to 0.01 mm, G 1/8 to G 4. Its \"minor (nut) diameter\" column is not the basic minor diameter (it is larger), so it is not compared."
  },
  "WIKI_NPT": {
   "publisher": "Wikipedia",
   "title": "National pipe thread (NPT dimensions table)",
   "url": "https://en.wikipedia.org/wiki/National_pipe_thread",
   "accessed": "2026-11-10",
   "note": "Names ASME B1.20.1 without a year. The 4 1/2 row is printed without engagement values. 1/16 OD printed .313; E1 is reproduced with 0.3125."
  },
  "UWASHER_NPT": {
   "publisher": "Ultimate Washer Inc.",
   "title": "NPT basic dimensions chart (reproduces the ANSI B2.1-1968 table)",
   "url": "https://ultimatewasher.com/dimensionschart.htm",
   "accessed": "2026-11-10",
   "note": "Equipment retailer; table credited to ANSI B2.1-1968, the predecessor of ASME B1.20.1. 1/16 OD printed .313. 4 in E1 printed 4.38712 (Wikipedia 4.38713; exact value 4.387125)."
  },
  "WIKI_BSW": {
   "publisher": "Wikipedia",
   "title": "British Standard Whitworth (BSW size table)",
   "url": "https://en.wikipedia.org/wiki/British_Standard_Whitworth",
   "accessed": "2026-11-10",
   "note": "Names BS 84:2007. Prints the profile constants 55 deg, depth 0.640327p, radius 0.137329p."
  },
  "EE_WHIT": {
   "publisher": "Engineers Edge",
   "title": "Whitworth British screw threads size chart, BSW and BSF",
   "url": "https://engineersedge.com/hardware/whitworth-screw-threads-chart.htm",
   "accessed": "2026-11-10",
   "note": "Sizes printed as \"11/8\" etc. read as 1 1/8. Checked against the BS 84 profile formulas: BSW 1/8 minor printed .0903 (formula .0930) and BSF 7/16 minor printed .3363 (formula .3664) look like digit errors. A BSW row printed \"4 3/4\" carries the 5 in major diameter and is not used."
  },
  "BF_BSF": {
   "publisher": "British Fasteners",
   "title": "British Threads - British Standard Fine (BSF table)",
   "url": "https://britishfasteners.com/threads-bsf",
   "accessed": "2026-11-10",
   "note": "Prints TPI, pitch, core (minor) diameter and tapping drills, 3/16 to 1 in. No standard number cited. Its 7/16 core .3663 agrees with the BS 84 profile, so the Engineers Edge .3363 is a digit error."
  },
  "WIKI_BA": {
   "publisher": "Wikipedia",
   "title": "British Association screw threads (size table)",
   "url": "https://en.wikipedia.org/wiki/British_Association_screw_threads",
   "accessed": "2026-11-10",
   "note": "Names BS 93:2008. States pitch = 0.9^n mm, major diameter = 6 p^1.2 mm, both rounded to two significant figures, angle 47.5 deg, depth 0.6p, radius 0.18083p. Table printed for 0 to 10 BA and 25 BA only."
  },
  "BF_BA": {
   "publisher": "British Fasteners",
   "title": "British Threads - BA (table, inch)",
   "url": "https://britishfasteners.com/threads-ba",
   "accessed": "2026-11-10",
   "note": "Prints diameters and pitch in inch, 0 to 16 BA. Its inch diameters differ slightly from the metric values converted (0 BA .2360 in against 6.0 mm = .2362 in), so only TPI is compared; diameters come from the BS 93 formula."
  }
 },
