{
  "_about": "ISO 2768-1:1989 general tolerances as printed by free publishers. Linear and radius values in mm (the +/- sign dropped); angular values converted from degrees and minutes to minutes of arc (1 deg 30' = 90). 'none' = the publisher prints a dash or 'not specified' (no general tolerance for that class and range). Where a publisher prints one merged column for two classes (f and m, or c and v), the value is recorded for both classes and the source note says so.",
  "sources": {
    "AMESWEB": {"publisher": "AmesWeb", "title": "ISO 2768-1 Linear Dimensions Tolerance Table", "url": "https://amesweb.info/fits-tolerances/iso-2768-linear-dimensions-tolerances.aspx", "accessed": "2026-11-11", "note": "Linear table and broken-edge table. The broken-edge m and v cells are empty on the page (merged cells in the original layout); not recorded. No angular table."},
    "STARRAPID": {"publisher": "Star Rapid", "title": "General Tolerances to DIN ISO 2768 (PDF)", "url": "https://cdn2.starrapid.com/wp-content/uploads/2023/09/General_Tolerances-DIN-ISO-2768.pdf", "accessed": "2026-11-11", "note": "Prints all four classes separately in all three tables. The angular table heads its ranges 'nominal length' rather than 'length of the shorter side'."},
    "MODULUS": {"publisher": "Modulus Metal", "title": "ISO 2768-1 and ISO 2768-2 tolerances", "url": "https://www.modulusmetal.com/iso-2768-1-and-iso-2768-2-tolerances", "accessed": "2026-11-11", "note": "Linear table; broken-edge f and c; angular f, c and v. The m cells (and broken-edge v) are not in the page text (merged cells); not recorded."},
    "CAMCUT": {"publisher": "CamCut Group", "title": "General tolerances for linear dimensions", "url": "https://www.camcut-group.com/en-us/support/instructions/measuring/general-tolerances/general-tolerances-for-linear-dimensions/", "accessed": "2026-11-11", "note": "Linear table only."},
    "WEVOLVER": {"publisher": "Wevolver", "title": "ISO 2768 General Tolerances: Tables, Classes and Current Status", "url": "https://www.wevolver.com/article/iso-2768-general-tolerances-tables-classes-current-status", "accessed": "2026-11-11", "note": "Broken-edge table prints one column headed 'f (fine) and m (medium)' and one headed 'c (coarse) and v (very coarse)'; angular table one column 'f and m', then c and v. Recorded for both classes of each merged column."}
